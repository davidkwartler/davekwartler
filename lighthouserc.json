{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4180/",
        "http://localhost:4180/shows",
        "http://localhost:4180/travel"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      },
      "startServerCommand": "npx serve out -l 4180 --no-clipboard",
      "startServerReadyPattern": "Accepting connections"
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4180/$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(shows|travel)$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
